# ======================================================================
# git 推送忽略文件
# ======================================================================

# ========== IDE / 编辑器 ==========
.vscode/
.idea/
*.code-workspace

# ========== Python ==========
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ========== 环境与密钥 ==========
.env
.env.docker
.env.*

# ========== 运行时目录（索引/日志/上传，可重建） ==========
runtime/

# ========== 大体积数据与模型（不入库，README 说明获取） ==========
# 精选注册图（data/<类名>/，运行必需但约 75MB，随发布包分发）
data/
# bge-small-zh 向量模型（约 92MB）
models/

# ========== 前端 ==========
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ========== 测试产物 ==========
playwright-report/
test-results/
frontend/playwright/.cache/

# ========== 系统 ==========
Thumbs.db
.DS_Store
